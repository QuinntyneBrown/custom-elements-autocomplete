{
  "name": "custom-elements-autocomplete",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/autocomplete/index.d.ts",
      "import": "./dist/autocomplete/index.js"
    },
    "./autocomplete": {
      "types": "./dist/autocomplete/autocomplete/index.d.ts",
      "import": "./dist/autocomplete/autocomplete.js"
    },
    "./product-autocomplete": {
      "types": "./dist/autocomplete/product-autocomplete/index.d.ts",
      "import": "./dist/autocomplete/product-autocomplete.js"
    }
  },
  "scripts": {
    "start": "vite --open /src/dev-app/",
    "watch": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tools/run-jest.mjs",
    "test:watch": "node tools/run-jest.mjs --watch",
    "test:coverage": "node tools/run-jest.mjs --coverage",
    "e2e": "playwright test"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "babel-jest": "30.5.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "dependencies": {
    "lit-html": "3.3.3",
    "rxjs": "7.8.2"
  }
}
